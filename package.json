  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:allure": "npm run allure:clean && playwright test",
    "allure:clean": "node -e \"for (const path of ['allure-results', 'allure-report']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "allure:generate": "allure generate allure-results --output allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure open allure-results"
  },
